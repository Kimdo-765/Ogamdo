{"id":"sample-ownership-001","title":"Fictional service: ownership check case","body":"# Root Cause\nAn authenticated request reaches an object lookup without an ownership decision.\n# Primitive\nThe requester can read an object belonging to another test account.\n# Technique\nA requester-controlled object reference reaches the lookup.\n# Outcome\nCross-account read was observed in a controlled test.\n# Constraints\nAuthentication is required; an ownership policy blocks the path.","source_type":"research_note","source_uri":"https://example.invalid/strata/sample-ownership-001","module":"web","metadata":{"product":"Fictional Service","component":"Object API","revision":"test-revision-1"},"relations":[{"from":{"kind":"root_cause","label":"missing ownership check"},"type":"produces","to":{"kind":"primitive","label":"cross-account read"},"status":"observed","evidence":{"section":"Root Cause","line_start":1,"line_end":4},"conditions":["authenticated requester"]},{"from":{"kind":"primitive","label":"cross-account read"},"type":"enables","to":{"kind":"technique","label":"object reference substitution"},"status":"observed","evidence":{"section":"Technique","line_start":5,"line_end":6},"conditions":["object reference accepted from requester"]},{"from":{"kind":"technique","label":"object reference substitution"},"type":"achieves","to":{"kind":"outcome","label":"cross-account disclosure"},"status":"observed","evidence":{"section":"Outcome","line_start":7,"line_end":8},"conditions":["ownership policy absent"]},{"from":{"kind":"technique","label":"object reference substitution"},"type":"blocked_by","to":{"kind":"condition","label":"ownership policy"},"status":"verified","evidence":{"section":"Constraints","line_start":9,"line_end":10},"conditions":[]}]}
{"id":"sample-tenant-002","title":"Fictional service: tenant filter case","body":"# Root Cause\nA test query applies a resource identifier but omits its tenant filter.\n# Primitive\nThe result includes a record from another test tenant.\n# Technique\nThe test follows a requester-controlled object reference into the query.\n# Outcome\nA cross-account read was reproduced in the test environment.\n# Constraints\nA tenant-aware query prevents the observed result.","source_type":"research_note","source_uri":"https://example.invalid/strata/sample-tenant-002","module":"web","metadata":{"product":"Fictional Service","component":"Tenant API","revision":"test-revision-2"},"relations":[{"from":{"kind":"root_cause","label":"missing tenant filter"},"type":"produces","to":{"kind":"primitive","label":"cross-account read"},"status":"observed","evidence":{"section":"Root Cause","line_start":1,"line_end":4},"conditions":["multi-tenant test data"]},{"from":{"kind":"primitive","label":"cross-account read"},"type":"enables","to":{"kind":"technique","label":"object reference substitution"},"status":"observed","evidence":{"section":"Technique","line_start":5,"line_end":6},"conditions":["resource identifier accepted from requester"]},{"from":{"kind":"technique","label":"object reference substitution"},"type":"blocked_by","to":{"kind":"condition","label":"tenant-aware query"},"status":"verified","evidence":{"section":"Constraints","line_start":9,"line_end":10},"conditions":[]}]}
